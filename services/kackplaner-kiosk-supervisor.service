[Unit]
Description=Kiosk Supervisor
After=network.target graphical.target

[Service]
Type=simple
User=kiosk
Environment=PYTHONUNBUFFERED=1

ExecStartPre=/bin/sh -c 'until [ -S /run/user/$(id -u)/wayland-0 ]; do sleep 1; done'

ExecStart=/usr/bin/python3 /usr/local/bin/kiosk-scripts/kiosk-supervisor.py

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target