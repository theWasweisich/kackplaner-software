[Unit]
Description=Kackplaner Frontend Service
After=network.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/opt/kackplaner/frontend/dist
EnvironmentFile=/opt/kackplaner.env

ExecStart=/usr/local/bin/serve -s . -l ${FRONTEND_PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
