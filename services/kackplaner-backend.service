[Unit]
Description=Kackplaner Backend Service
After=network.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/opt/kackplaner/backend/
EnvironmentFile=/opt/kackplaner.env

ExecStart=/usr/bin/node /opt/kackplaner/backend/src/main.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
